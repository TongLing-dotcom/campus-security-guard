# 统一换行符为 LF，避免跨平台 diff 噪声
* text=auto eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.wav  binary
*.mp3  binary
*.mp4  binary
*.ttf  binary
*.otf  binary

# 语言与文档
*.py   text diff=python
*.md   text
*.json text
*.srt  text
*.ass  text
*.mlt  text

# 锁定大文件不参与 diff 统计
*.mp4  -diff
*.wav  -diff
